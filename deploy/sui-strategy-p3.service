[Unit]
Description=SOL-bot P3 independent SUI math worker
After=network-online.target solbot-market.service
[Service]
ExecStart=/opt/sol-bot/venv/bin/python -m solbot.p3_runtime --symbol SUIUSDT --micro-db /var/lib/sol-bot/database/sui-micro.sqlite --audit-db /var/lib/sol-bot/database/sui-math-audit.sqlite --market-db /var/lib/sol-bot/database/sui-market.sqlite --strategy-db /var/lib/sol-bot/database/sui-strategy-strategy.sqlite --status-path /var/lib/sol-bot/sui-strategy-status.json
Type=simple
User=solbot
Group=solbot
WorkingDirectory=/opt/sol-bot/p3
Environment=PYTHONPATH=/opt/sol-bot/p3/backend/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=20
MemoryHigh=180M
MemoryMax=300M
CPUQuota=25%
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/sol-bot
ReadWritePaths=/var/lib/sol-bot
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target

