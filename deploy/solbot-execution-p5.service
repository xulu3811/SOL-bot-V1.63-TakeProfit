[Unit]
Description=SOL-bot P5 execution OFF watchdog
After=solbot-guardian-ipc.service
Requires=solbot-guardian-ipc.service
[Service]
User=solbot-exec
Group=solbot-exec
SupplementaryGroups=solbot
WorkingDirectory=/opt/sol-bot/p5
Environment=PYTHONPATH=/opt/sol-bot/p5/backend/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/sol-bot/venv/bin/python -m solbot.p5_runtime --database /var/lib/sol-bot-execution/orders.sqlite --status-path /var/lib/sol-bot-execution/status.json
StateDirectory=sol-bot-execution
StateDirectoryMode=0750
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/sol-bot-execution
InaccessiblePaths=-/var/lib/sol-bot/database -/opt/sol-bot/secrets
MemoryMax=128M
CPUQuota=10%
Restart=on-failure
RestartSec=15
UMask=0027
[Install]
WantedBy=multi-user.target
