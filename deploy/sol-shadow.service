[Unit]
Description=SOL-bot P2 isolated research worker
After=network-online.target solbot-market.service
[Service]
ExecStart=/opt/sol-bot/venv/bin/python -m solbot.p2_runtime --symbol SOLUSDT --market-db /var/lib/sol-bot/database/market.sqlite --strategy-db /var/lib/sol-bot/database/sol-shadow-strategy.sqlite --status-path /var/lib/sol-bot/sol-shadow-status.json --shadow-db /var/lib/sol-bot/database/sol-shadow.sqlite
Type=simple
User=solbot
Group=solbot
WorkingDirectory=/opt/sol-bot/p2
Environment=PYTHONPATH=/opt/sol-bot/p2/backend/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=20
MemoryHigh=180M
MemoryMax=300M
CPUQuota=25%
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/sol-bot
ReadWritePaths=/var/lib/sol-bot
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
[Install]
WantedBy=multi-user.target
